import math

class TreeNode:
    """
    A node in a tree.
    """
    
    def __init__(self):
        self.children = None
        self.distance = 0.0
        
    def add_children(self, child1, child2):
        """Add two children to this node."""
        self.children = [child1, child2]
        
    def distance_to(self, other):
        """Calculate distance to another node."""
        # Simplified - just return the sum of distances
        # This is a simplified version for Codon compatibility
        return self.distance + other.distance

class Tree:
    """
    A tree data structure for phylogenetic analysis.
    """
    
    def __init__(self, root):
        self.root = root
        self._leaves = None
        
    @property
    def leaves(self):
        """Get all leaf nodes in the tree."""
        if self._leaves is None:
            self._leaves = []
            if self.root is not None:
                self._collect_leaves(self.root, self._leaves)
        return self._leaves
        
    def _collect_leaves(self, node, leaf_list):
        """Recursively collect leaf nodes."""
        if node.children is None or len(node.children) == 0:
            leaf_list.append(node)
        else:
            for child in node.children:
                self._collect_leaves(child, leaf_list)