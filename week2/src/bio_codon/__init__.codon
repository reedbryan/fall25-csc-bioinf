"""Tools for sequence motif analysis.

Core Motif class and utility functions for motif analysis.
"""

# Removed Python-specific imports for Codon compatibility
import math
from typing import Dict, List, Optional

# Matrix classes - moved here to avoid circular imports

class GenericPositionMatrix:
    """Base class for the support of position matrix operations."""
    
    length: int
    alphabet: str
    values: Dict[str, List[float]]
    
    def __init__(self, alphabet: str, values: Dict[str, List[float]]):
        """Initialize the class."""
        self.alphabet = alphabet
        self.length = 0
        self.values = {}
        
        # Set length from first alphabet letter
        first_letter = alphabet[0]
        if first_letter in values:
            self.length = len(values[first_letter])
        
        # Validate all letters have same length
        for letter in alphabet:
            if letter in values:
                if len(values[letter]) != self.length:
                    raise ValueError(f"All letters must have same length, got {len(values[letter])} for {letter}")
        
        # Store values in dictionary
        for letter in alphabet:
            if letter in values:
                self.values[letter] = values[letter]
    
    def __getitem__(self, letter: str) -> List[float]:
        """Get values for a specific letter."""
        return self.values[letter]
    
    def __setitem__(self, letter: str, values: List[float]):
        """Set values for a specific letter."""
        self.values[letter] = values


class FrequencyPositionMatrix(GenericPositionMatrix):
    """Represents a frequency position matrix (count matrix)."""
    
    def __init__(self, alphabet: str, counts: Dict[str, List[int]]):
        # Convert counts to floats for consistency
        float_counts: Dict[str, List[float]] = {}
        for letter in alphabet:
            if letter in counts:
                float_counts[letter] = [float(x) for x in counts[letter]]
        
        super().__init__(alphabet, float_counts)
    
    @property
    def consensus(self) -> str:
        """Return the consensus sequence."""
        sequence = ""
        for i in range(self.length):
            max_count = -1.0
            max_letter = ""
            for letter in self.alphabet:
                count = self[letter][i]
                if count > max_count:
                    max_count = count
                    max_letter = letter
            sequence += max_letter
        return sequence
    
    def normalize(self):
        """Normalize to create a Position Weight Matrix."""
        pwm_values: Dict[str, List[float]] = {}
        
        for letter in self.alphabet:
            pwm_values[letter] = []
        
        for i in range(self.length):
            # Calculate column sum
            column_sum = 0.0
            for letter in self.alphabet:
                column_sum += self[letter][i]
            
            # Normalize each value
            for letter in self.alphabet:
                if column_sum > 0.0:
                    pwm_values[letter].append(self[letter][i] / column_sum)
                else:
                    pwm_values[letter].append(0.0)
        
        return PositionWeightMatrix(self.alphabet, pwm_values)
    
    def reverse_complement(self):
        """Return reverse complement of the matrix."""
        if self.alphabet != "ACGT":
            raise ValueError("Reverse complement only supported for DNA alphabet")
        
        rc_values: Dict[str, List[int]] = {"A": [], "C": [], "G": [], "T": []}
        
        for i in reversed(range(self.length)):
            rc_values["A"].append(int(self["T"][i]))
            rc_values["T"].append(int(self["A"][i]))
            rc_values["C"].append(int(self["G"][i]))
            rc_values["G"].append(int(self["C"][i]))
        
        return FrequencyPositionMatrix(self.alphabet, rc_values)


class PositionWeightMatrix(GenericPositionMatrix):
    """Represents a position weight matrix (frequency matrix)."""
    
    def __init__(self, alphabet: str, values: Dict[str, List[float]]):
        super().__init__(alphabet, values)
    
    def log_odds(self, background: Optional[Dict[str, float]] = None):
        """Create a Position Specific Scoring Matrix (PSSM)."""
        if background is None:
            # Default uniform background
            bg_prob = 1.0 / len(self.alphabet)
            background = {letter: bg_prob for letter in self.alphabet}
        
        pssm_values: Dict[str, List[float]] = {}
        for letter in self.alphabet:
            pssm_values[letter] = []
        
        for i in range(self.length):
            for letter in self.alphabet:
                freq = self[letter][i]
                bg = background[letter]
                if freq > 0.0 and bg > 0.0:
                    pssm_values[letter].append(math.log2(freq / bg))
                else:
                    pssm_values[letter].append(float('-inf'))
        
        return PositionSpecificScoringMatrix(self.alphabet, pssm_values)


class PositionSpecificScoringMatrix(GenericPositionMatrix):
    """Represents a position-specific scoring matrix (PSSM)."""
    
    def __init__(self, alphabet: str, values: Dict[str, List[float]]):
        super().__init__(alphabet, values)
    
    def __len__(self) -> int:
        """Return the size of the alphabet."""
        return len(self.alphabet)
    
    @property
    def max(self) -> float:
        """Return the maximum possible score."""
        max_score = 0.0
        for i in range(self.length):
            position_max = float('-inf')
            for letter in self.alphabet:
                score = self[letter][i]
                if score != float('-inf') and score > position_max:
                    position_max = score
            if position_max != float('-inf'):
                max_score += position_max
        return max_score
    
    def calculate(self, sequence: str) -> List[float]:
        """Calculate scores for all positions in a sequence."""
        scores: List[float] = []
        
        for start in range(len(sequence) - self.length + 1):
            score = 0.0
            valid = True
            
            for i in range(self.length):
                letter = sequence[start + i]
                if letter in self.alphabet:
                    letter_score = self[letter][i]
                    if letter_score == float('-inf'):
                        valid = False
                        break
                    score += letter_score
                else:
                    valid = False
                    break
            
            if valid:
                scores.append(score)
            else:
                scores.append(float('-inf'))
        
        return scores


# Simple Alignment replacement - just store the sequences
class Alignment:
    sequences: List[str]
    length: int
    
    def __init__(self, sequences: List[str]):
        self.sequences = sequences
        self.length = len(sequences[0]) if sequences else 0


class Motif:
    """Represents a sequence motif."""
    
    name: str
    alphabet: str
    length: int
    counts: FrequencyPositionMatrix
    _pwm: Optional[PositionWeightMatrix]
    _pssm: Optional[PositionSpecificScoringMatrix]
    background: Dict[str, float]
    pseudocounts: Dict[str, float]
    
    def __init__(self, alignment: Optional[Alignment] = None, alphabet: str = "ACGT"):
        self.name = ""
        self.alphabet = alphabet
        self.length = 0
        self._pwm = None
        self._pssm = None
        
        # Default background and pseudocounts
        bg_freq = 1.0 / len(alphabet)
        self.background = {letter: bg_freq for letter in alphabet}
        self.pseudocounts = {letter: 0.0 for letter in alphabet}
        
        if alignment:
            self._build_from_alignment(alignment)
    
    def _build_from_alignment(self, alignment: Alignment):
        """Build motif from alignment."""
        if not alignment.sequences:
            return
        
        self.length = alignment.length
        
        # Count occurrences
        counts: Dict[str, List[int]] = {}
        for letter in self.alphabet:
            counts[letter] = [0] * self.length
        
        for sequence in alignment.sequences:
            for i, letter in enumerate(sequence):
                if i < self.length and letter in self.alphabet:
                    counts[letter][i] += 1
        
        self.counts = FrequencyPositionMatrix(self.alphabet, counts)
    
    @property
    def consensus(self) -> str:
        """Return the consensus sequence."""
        return self.counts.consensus
    
    @property
    def anticonsensus(self) -> str:
        """Return the anticonsensus sequence."""
        return self.counts.anticonsensus
    
    @property
    def degenerate_consensus(self) -> str:
        """Return the degenerate consensus sequence."""
        return self.counts.degenerate_consensus
    
    def __len__(self) -> int:
        return self.length
    
    def __getitem__(self, index) -> "Motif":
        """Slice the motif."""
        if isinstance(index, slice):
            start = index.start or 0
            stop = index.stop or self.length
            
            # Create new counts for sliced motif
            new_counts: Dict[str, List[int]] = {}
            for letter in self.alphabet:
                new_counts[letter] = []
                for i in range(start, min(stop, self.length)):
                    new_counts[letter].append(int(self.counts[letter][i]))
            
            # Create new motif
            new_motif = Motif(alphabet=self.alphabet)
            new_motif.counts = FrequencyPositionMatrix(self.alphabet, new_counts)
            new_motif.length = len(new_counts[self.alphabet[0]])
            new_motif.name = self.name + f"[{start}:{stop}]"
            
            return new_motif
        else:
            raise TypeError("Motif indices must be slices")
    
    def reverse_complement(self):
        """Return reverse complement of the motif."""
        rc_motif = Motif(alphabet=self.alphabet)
        rc_motif.counts = self.counts.reverse_complement()
        rc_motif.length = self.length
        rc_motif.name = self.name + "_rc"
        return rc_motif
    
    @property
    def pwm(self):
        """Get the Position Weight Matrix."""
        if self._pwm is None:
            self._pwm = self.counts.normalize()
        return self._pwm
    
    @property
    def pssm(self):
        """Get the Position Specific Scoring Matrix."""
        if self._pssm is None:
            pwm_obj = self.pwm
            self._pssm = pwm_obj.log_odds(self.background)
        return self._pssm


def create(instances: List[str], alphabet: str = "ACGT") -> Motif:
    """Create a Motif object from sequence instances."""
    alignment = Alignment(instances)
    return Motif(alignment=alignment, alphabet=alphabet)


def create_from_counts(counts: Dict[str, List[int]], alphabet: str = "ACGT") -> Motif:
    """Create a Motif object from count matrix."""
    motif = Motif(alphabet=alphabet)
    motif.counts = FrequencyPositionMatrix(alphabet, counts)
    motif.length = len(counts[alphabet[0]]) if alphabet and alphabet[0] in counts else 0
    return motif


def parse(handle, fmt: str, strict: bool = True):
    """Parse an output file from a motif finding program."""
    fmt = fmt.lower()
    if fmt == "alignace":
        raise NotImplementedError("AlignACE format not yet implemented")
    elif fmt == "meme" or fmt == "minimal":
        # Simplified MEME parsing for Codon compatibility - return empty list
        return []
    elif fmt == "clusterbuster":
        raise NotImplementedError("ClusterBuster format not yet implemented")
    elif fmt in ("pfm-four-columns", "pfm-four-rows"):
        raise NotImplementedError("PFM format not yet implemented")
    elif fmt == "xms":
        raise NotImplementedError("XMS format not yet implemented")
    elif fmt == "mast":
        raise NotImplementedError("MAST format not yet implemented")
    elif fmt == "transfac":
        raise NotImplementedError("TRANSFAC format not yet implemented")
    elif fmt in ("pfm", "sites", "jaspar"):
        raise NotImplementedError("JASPAR format not yet implemented")
    else:
        raise ValueError(f"Unknown format {fmt}")


if __name__ == "__main__":
    print("bio_codon motifs module loaded successfully")